# Copy to .env (or just run `make init`, which generates random values).
SIM_SPEED=20                       # simulator time acceleration (20 = 1 simulated hour every 3 minutes)
INFLUX_ADMIN_PASSWORD=change-me-please
INFLUX_ADMIN_TOKEN=change-me-to-a-long-random-token
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ANONYMOUS_VIEWER=false     # true = read-only kiosk without login (handy for demos)
# INFLUXDB_VERSION=2.7
# GRAFANA_VERSION=11.4.0
