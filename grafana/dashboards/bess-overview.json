          },
          "query": "from(bucket: \"bess\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r.device == \"pcs01\" and (r._field == \"energy_charged_kwh\" or r._field == \"energy_discharged_kwh\"))\n  |> spread()\n  |> keep(columns: [\"_value\", \"_field\"])"
