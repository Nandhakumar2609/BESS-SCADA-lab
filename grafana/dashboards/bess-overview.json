    {
      "id": 12,
      "type": "timeseries",
      "title": "Power flow",
      "datasource": {
        "type": "influxdb",
        "uid": "bess-influx"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "bess-influx"
          },
          "query": "from(bucket: \"bess\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r.device == \"pcs01\" and r._field == \"active_power_kw\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> set(key: \"_field\", value: \"PCS\")\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "bess-influx"
          },
          "query": "from(bucket: \"bess\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r.device == \"meter_poi\" and r._field == \"p_total_kw\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> set(key: \"_field\", value: \"POI (grid)\")\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "influxdb",
            "uid": "bess-influx"
          },
          "query": "from(bucket: \"bess\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r.device == \"meter_aux\" and r._field == \"p_total_kw\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> set(key: \"_field\", value: \"Auxiliary\")\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "kwatt",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "description": "PCS: + discharge. POI: + export to grid. AUX: site consumption (HVAC, controls)."
    },
