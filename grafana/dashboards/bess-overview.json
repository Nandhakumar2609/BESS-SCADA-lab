{
  "uid": "bess-overview",
  "title": "BESS Site Overview",
  "tags": [
    "bess",
    "overview"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "2s",
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Site status",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "State of charge",
      "datasource": {
        "type": "influxdb",
        "uid": "bess-influx"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "bess-influx"
          },
          "query": "from(bucket: \"bess\")\n  |> range(start: -1m)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r.device == \"bms01\" and r._field == \"soc_pct\")\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "green",
                "value": 20
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          },
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "PCS state",
      "datasource": {
        "type": "influxdb",
        "uid": "bess-influx"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "bess-influx"
          },
          "query": "from(bucket: \"bess\")\n  |> range(start: -1m)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r.device == \"pcs01\" and r._field == \"state\")\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ],
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "STOPPED",
                  "color": "text",
                  "index": 0
                },
                "1": {
                  "text": "STANDBY",
                  "color": "blue",
                  "index": 1
                },
                "2": {
                  "text": "CHARGING",
                  "color": "green",
                  "index": 2
                },
                "3": {
                  "text": "DISCHARGING",
                  "color": "orange",
                  "index": 3
                },
                "4": {
                  "text": "FAULT",
                  "color": "red",
                  "index": 4
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
