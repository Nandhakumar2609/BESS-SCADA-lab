    {
      "id": 5,
      "type": "stat",
      "title": "Availability (time range)",
      "datasource": {
        "type": "influxdb",
        "uid": "bess-influx"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "bess-influx"
          },
          "query": "from(bucket: \"bess\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"site\" and r._field == \"available\")\n  |> mean()\n  |> map(fn: (r) => ({r with _value: r._value * 100.0}))\n  |> keep(columns: [\"_value\"])"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 98
              }
            ]
          },
          "unit": "percent",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "description": "Share of scans where PCS and BMS are online, not faulted and the DC contactor is closed"
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Active alarms",
      "datasource": {
        "type": "influxdb",
        "uid": "bess-influx"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "bess-influx"
          },
          "query": "from(bucket: \"bess\")\n  |> range(start: -1m)\n  |> filter(fn: (r) => r._measurement == \"site\" and r._field =~ /^alarms_/)\n  |> last()\n  |> keep(columns: [\"_value\", \"_field\"])"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "alarms_critical"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Critical"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "alarms_major"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Major"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "alarms_minor"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Minor"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "alarms_warning"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Warning"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
