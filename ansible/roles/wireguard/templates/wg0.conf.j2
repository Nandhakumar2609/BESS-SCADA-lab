# WireGuard server on the OT edge firewall - generated by Ansible, do not edit.
[Interface]
Address = {{ vpn.fw_ip }}/{{ vpn.subnet.split('/')[1] }}
ListenPort = {{ vpn.port }}
PrivateKey = {{ wg_keys['fw'].private }}

{% for p in vpn.peers %}
# {{ p.name }} ({{ p.role }})
[Peer]
PublicKey = {{ wg_keys[p.name].public }}
PresharedKey = {{ wg_keys[p.name].psk }}
AllowedIPs = {{ p.ip }}/32

{% endfor %}
